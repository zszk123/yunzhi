# ---- 环境 ----
APP_ENV=dev
LOG_LEVEL=INFO

# ---- 后端服务 ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ---- PostgreSQL 17（pgvector 镜像）----
POSTGRES_USER=yunzhi
POSTGRES_PASSWORD=yunzhi
POSTGRES_DB=yunzhi
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://yunzhi:yunzhi@127.0.0.1:5432/yunzhi

# ---- Qdrant ----
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333

# ---- Redis ----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---- MinIO ----
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=yunzhi-files
